{
	"name": "storybook-composition",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/StorybookComposition/src",
	"projectType": "application",
	"tags": [],
	"// targets": "to see all targets run: nx show project StorybookComposition --web",
	"targets": {
		"storybook-composition": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["nx storybook deck-gl", "nx storybook ra-geospatial"],
				"parallel": true
			}
		},
		"prettier": {
			"executor": "@nx/workspace:run-commands",
			"options": {
				"command": "prettier --check ."
			}
		}
	}
}
