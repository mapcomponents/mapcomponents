{
	"compileOnSave": false,
	"compilerOptions": {
		"baseUrl": ".",
		"rootDir": ".",
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"isolatedModules": true,
		"noEmitOnError": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strict": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"moduleResolution": "bundler",
		"module": "es2015",
		"types": ["vite/client"],
		"composite": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"target": "ES2020",
		"paths": {
			"@mapcomponents/deck-gl/*": ["libs/deck-gl/src/*"],
			"@mapcomponents/ra-geospatial/*": ["./libs/ra-geospatial/src/*"]
		}
	}
}
